<UserControl x:Class="PhotoCommander.Controls.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="PaneBorder" BorderThickness="2"
          BorderBrush="{StaticResource NcInactiveBorder}"
          Background="{StaticResource NcBack}">
    <DockPanel>
      <!-- строка пути -->
      <DockPanel DockPanel.Dock="Top" Margin="2">
        <ComboBox x:Name="DriveBox" Width="58" DockPanel.Dock="Left"
                  SelectionChanged="DriveBox_SelectionChanged" ToolTip="Диск"/>
        <Button DockPanel.Dock="Right" Content="…" Width="26" Margin="2,0,0,0"
                Click="Browse_Click" ToolTip="Выбрать папку"/>
        <Button DockPanel.Dock="Right" Content="↑" Width="26" Margin="2,0,0,0"
                Click="Up_Click" ToolTip="Вверх (Backspace)"/>
        <TextBox x:Name="PathBox" Margin="2,0,0,0" VerticalContentAlignment="Center"
                 Background="{StaticResource NcBack}" Foreground="#FFFF55" CaretBrush="White"
                 BorderBrush="#00A8A8" FontFamily="Consolas" KeyDown="PathBox_KeyDown"
                 ToolTip="Введите путь и нажмите Enter"/>
      </DockPanel>

      <!-- строка состояния панели -->
      <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Margin="4,2"
                 Foreground="{StaticResource NcText}" FontFamily="Consolas"
                 TextTrimming="CharacterEllipsis"/>

      <!-- список файлов -->
      <ListView x:Name="FileList" Background="{StaticResource NcBack}" BorderThickness="0"
                Foreground="{StaticResource NcText}" FontFamily="Consolas" FontSize="13"
                SelectionMode="Extended" ItemContainerStyle="{StaticResource NcItem}"
                TextSearch.TextPath="Name"
                VirtualizingPanel.IsVirtualizing="True"
                MouseDoubleClick="FileList_MouseDoubleClick"
                KeyDown="FileList_KeyDown"
                SelectionChanged="FileList_SelectionChanged">
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource NcHeader}">
            <GridViewColumn Header="Имя" Width="250" DisplayMemberBinding="{Binding DisplayName}"/>
            <GridViewColumn Header="Размер" Width="85" DisplayMemberBinding="{Binding SizeText}"/>
            <GridViewColumn Header="Дата" Width="125" DisplayMemberBinding="{Binding DateText}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </DockPanel>
  </Border>
</UserControl>
