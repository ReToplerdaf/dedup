<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoCommander</RootNamespace>
    <AssemblyName>PhotoCommander</AssemblyName>
    <!-- запускаться и на более новых версиях .NET (9, 10 …) -->
    <RollForward>Major</RollForward>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- в WPF-проектах System.IO не подключается автоматически -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenCV для .NET + нативные библиотеки под Windows -->
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.*" />
  </ItemGroup>

</Project>
