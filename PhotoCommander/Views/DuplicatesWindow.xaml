<Window x:Class="PhotoCommander.Views.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Похожие фото" Height="780" Width="1250"
        WindowStartupLocation="CenterOwner" Background="#000080">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#C0C0C0" Padding="8" BorderBrush="Black" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock x:Name="Summary" FontWeight="Bold" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,6,0,0">
          <Button Content="Отметить всё, кроме лучших" Style="{StaticResource CmdButton}" Margin="0,0,6,0" Click="MarkAuto_Click"/>
          <Button Content="Снять все отметки" Style="{StaticResource CmdButton}" Margin="0,0,6,0" Click="UnmarkAll_Click"/>
          <Button Content="Переместить отмеченные…" Style="{StaticResource CmdButton}" Margin="0,0,6,0" Click="MoveMarked_Click"/>
          <Button Content="Отмеченные в Корзину" Style="{StaticResource CmdButton}" Margin="0,0,6,0" Click="RecycleMarked_Click"/>
          <Button Content="Сохранить отчёт CSV" Style="{StaticResource CmdButton}" Margin="0,0,6,0" Click="SaveCsv_Click"/>
        </WrapPanel>
        <TextBlock Margin="0,4,0,0" Foreground="#303030" TextWrapping="Wrap"
                   Text="Красная рамка — отмечено (будет перемещено/удалено), зелёная — останется. «★ Оставить это» — оставить только это фото в группе. Двойной щелчок по фото — открыть."/>
      </StackPanel>
    </Border>

    <ListBox x:Name="GroupList" Background="#000080" BorderThickness="0"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter Margin="6,4"/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>

      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#00A8A8" BorderThickness="1" Padding="6">
            <StackPanel>
              <TextBlock Text="{Binding Header}" Foreground="#FFFF55" FontWeight="Bold" Margin="2,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="Card" Width="240" Margin="4" Padding="6" Background="#101060"
                            BorderThickness="3" BorderBrush="#55FF55"
                            Tag="{Binding}" MouseLeftButtonDown="Card_MouseDown">
                      <StackPanel>
                        <Grid Height="170" Background="Black">
                          <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding Badge}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Background="#CC000000" Foreground="White" Padding="4,1"/>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                        <TextBlock Text="{Binding Folder}" Foreground="#80C0C0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
                        <TextBlock Text="{Binding Info}" Foreground="#00FFFF"/>
                        <TextBlock Text="{Binding When}" Foreground="#00FFFF"/>
                        <TextBlock Text="{Binding Reason}" Foreground="#A0A0A0" FontStyle="Italic"/>
                        <DockPanel Margin="0,4,0,0">
                          <Button DockPanel.Dock="Right" Content="★ Оставить это" Padding="4,1"
                                  Tag="{Binding}" Click="KeepThis_Click"/>
                          <CheckBox IsChecked="{Binding Marked}" Content="В дубликаты"
                                    Foreground="White" VerticalAlignment="Center"/>
                        </DockPanel>
                      </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Marked}" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="#FF5555"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
