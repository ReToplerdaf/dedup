<Application x:Class="PhotoCommander.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Палитра в духе Norton Commander -->
    <SolidColorBrush x:Key="NcBack" Color="#000080"/>
    <SolidColorBrush x:Key="NcText" Color="#00FFFF"/>
    <SolidColorBrush x:Key="NcActiveBorder" Color="#55FFFF"/>
    <SolidColorBrush x:Key="NcInactiveBorder" Color="#303070"/>
    <SolidColorBrush x:Key="NcPanel" Color="#C0C0C0"/>

    <Style x:Key="NcHeader" TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#000080"/>
      <Setter Property="Foreground" Value="#FFFF55"/>
      <Setter Property="BorderBrush" Value="#00A8A8"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style x:Key="NcItem" TargetType="ListViewItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#00FFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="2,1">
              <GridViewRowPresenter VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    Columns="{TemplateBinding GridView.ColumnCollection}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#00A8A8"/>
                <Setter Property="Foreground" Value="Black"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontWeight" Value="Bold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsImage}" Value="True">
          <Setter Property="Foreground" Value="#FFFF55"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CmdButton" TargetType="Button">
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#00A8A8"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="BorderBrush" Value="#404040"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

  </Application.Resources>
</Application>
